# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# SQS queues
RAW_EVENTS_QUEUE=raw-events
PROCESSED_EVENTS_QUEUE=processed-events

# DynamoDB tables
EVENTS_TABLE=events
DEVELOPER_SUMMARY_TABLE=developer_summary

# Processor
PROCESSOR_WORKERS=5
PROCESSOR_ID=processor-1
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=10

# Aggregator
AGGREGATOR_WORKERS=5
HTTP_PORT=8080

LOG_LEVEL=info
